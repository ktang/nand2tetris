// File name: projects/1/DMux4Way.hdl
/**
 * 4-way demultiplexor:
 * [a, b, c, d] = [in, 0, 0, 0] if sel = 00
 *                [0, in, 0, 0] if sel = 01
 *                [0, 0, in, 0] if sel = 10
 *                [0, 0, 0, in] if sel = 11
 */
CHIP DMux4Way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:
    //// Replace this comment with your code.
    Or(a = sel[0], b = sel[1], out = sel1);
    Not(in = sel1, out = sel12);
    Mux(a = false, b = in, sel = sel12, out = a);

    Not(in = sel[1], out = NotSel1);
    And(a = NotSel1, b = sel[0], out = sel2);
    Mux(a = false, b = in, sel = sel2, out = b);

    Not(in = sel[0], out = NotSel0);
    And(a = NotSel0, b = sel[1], out = sel3);
    Mux(a = false, b = in, sel = sel3, out = c);

    And(a = sel[0], b = sel[1], out = sel4);
    Mux(a = false, b = in, sel = sel4, out = d);
}